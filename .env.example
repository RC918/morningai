# Worker

# Redis Queue name for task processing
# Required: False
RQ_QUEUE_NAME=orchestrator

# RQ serializer type (json/pickle)
# Required: False
RQ_SERIALIZER=json

# Job timeout in seconds for orchestrator RQ worker jobs (run_orchestrator_task). Controls how long LLM Planner and other agent tasks may run before being marked as failed due to timeout. Increase for long-running tasks (e.g., 4-5 minute LLM Planner executions).
# Default 600 seconds (10 minutes) allows LLM Planner tasks to complete.
# Lower values (180s) may cause AbandonedJobError for long-running tasks.
# Higher values (900s+) may be needed for complex multi-step workflows.
# Required: False
RQ_JOB_TIMEOUT=600

# Task enqueue TTL in seconds. Tasks not started within this time are discarded from the queue.
# Default 600 seconds (10 minutes).
# Tasks waiting longer than this in the queue will be discarded.
# Increase for high-load scenarios where queue backlog is expected.
# Required: False
RQ_TASK_TTL=600

# Result retention TTL in seconds. Successful job results are kept for this duration.
# Default 86400 seconds (24 hours).
# Results can be retrieved within this window after job completion.
# Increase for debugging or audit requirements.
# Required: False
RQ_RESULT_TTL=86400

# Failure retention TTL in seconds. Failed job records are kept for this duration.
# Default 3600 seconds (1 hour).
# Failed jobs can be inspected or retried within this window.
# Increase for debugging or manual retry scenarios.
# Required: False
RQ_FAILURE_TTL=3600

