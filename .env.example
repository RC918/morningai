# MorningAI Environment Variables
# Generated from common/config/settings.py
#
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================================================
# REQUIRED VARIABLES (must be set)
# ============================================================================

# ============================================================================
# OPTIONAL VARIABLES (have defaults)
# ============================================================================

# JWT token signing key for authentication
# Type: Optional
# JWT_SECRET_KEY=

# Admin user password for system access
# Type: Optional
# ADMIN_PASSWORD=

# Flask application secret key for sessions
# Type: Optional
# Alias: SECRET_KEY
# FLASK_SECRET_KEY=

# DEPRECATED: Use flask_secret_key instead
# Type: Optional
# SECRET_KEY=

# Master encryption key for sensitive data
# Type: Optional
# Alias: MASTER_KEY
# ENCRYPTION_MASTER_KEY=

# DEPRECATED: Use encryption_master_key instead
# Type: Optional
# MASTER_KEY=

# Fernet encryption key for TOTP secrets
# Type: Optional
# TOTP_ENCRYPTION_KEY=

# Enable Secure flag on authentication cookies (HTTPS-only)
# Type: bool
# Default: True
# COOKIE_SECURE=True

# SameSite attribute for authentication cookies
# Type: Literal
# Default: Lax
# COOKIE_SAMESITE=Lax

# PostgreSQL database connection URL
# Type: Optional
# DATABASE_URL=

# Redis connection URL for queue and caching
# Type: str
# Default: redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# Supabase memory table name for vector storage
# Type: str
# Default: memory
# MEMORY_TABLE=memory

# Supabase PostgreSQL database password
# Type: Optional
# SUPABASE_DB_PASSWORD=

# Redis key prefix for namespacing
# Type: str
# Default: morningai
# REDIS_KEY_PREFIX=morningai

# Maximum database connection pool size
# Type: int
# Default: 10
# DB_POOL_MAX=10

# Supabase project URL
# Type: Optional
# SUPABASE_URL=

# Supabase anonymous/public key
# Type: Optional
# SUPABASE_ANON_KEY=

# Supabase service role key (admin access)
# Type: Optional
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare API token for DNS/CDN management
# Type: Optional
# CLOUDFLARE_API_TOKEN=

# Cloudflare zone ID for domain
# Type: Optional
# CLOUDFLARE_ZONE_ID=

# Vercel deployment token
# Type: Optional
# VERCEL_TOKEN=

# Vercel organization ID
# Type: Optional
# VERCEL_ORG_ID=

# Vercel project ID
# Type: Optional
# VERCEL_PROJECT_ID=

# Vercel team ID (alternative to vercel_org_id)
# Type: Optional
# VERCEL_TEAM_ID=

# New Vercel token for migration
# Type: Optional
# VERCEL_TOKEN_NEW=

# Secondary Vercel token for testing
# Type: Optional
# VERCEL_TOKEN_2=

# Render API key for deployments
# Type: Optional
# RENDER_API_KEY=

# Render instance ID (auto-set by Render platform)
# Type: Optional
# RENDER_INSTANCE_ID=

# Upstash Redis REST API URL
# Type: Optional
# UPSTASH_REDIS_REST_URL=

# Upstash Redis REST API token
# Type: Optional
# UPSTASH_REDIS_REST_TOKEN=

# Fly.io API token for sandbox deployments
# Type: Optional
# FLY_API_TOKEN=

# Sentry DSN for error tracking
# Type: Optional
# SENTRY_DSN=

# Sentry authentication token for API access
# Type: Optional
# SENTRY_AUTH_TOKEN=

# Sentry environment name
# Type: str
# Default: production
# SENTRY_ENVIRONMENT=production

# Enable Sentry error tracking
# Type: bool
# Default: True
# SENTRY_ENABLED=True

# Sentry organization slug
# Type: Optional
# SENTRY_ORG=

# Email address for system alerts
# Type: Optional
# ALERT_EMAIL=

# Slack channel for alerts
# Type: Optional
# ALERT_SLACK_CHANNEL=

# Monitoring system base URL
# Type: Optional
# MONITOR_BASE_URL=

# Monitoring system authentication token
# Type: Optional
# MONITOR_AUTH_TOKEN=

# Cost alert threshold in USD
# Type: float
# Default: 50.0
# COST_ALERT_THRESHOLD=50.0

# Latency alert threshold in milliseconds
# Type: float
# Default: 5000.0
# LATENCY_ALERT_THRESHOLD=5000.0

# GitHub API token for repository operations
# Type: Optional
# GITHUB_TOKEN=

# GitHub repository in owner/repo format
# Type: str
# Default: RC918/morningai
# GITHUB_REPO=RC918/morningai

# GitHub token for agent operations
# Type: Optional
# AGENT_GITHUB_TOKEN=

# OpenAI API key for embeddings and LLM operations
# Type: Optional
# OPENAI_API_KEY=

# Maximum daily OpenAI API cost in USD
# Type: float
# Default: 100.0
# OPENAI_MAX_DAILY_COST=100.0

# OpenAI model for dev agent
# Type: str
# Default: gpt-4
# DEV_AGENT_MODEL=gpt-4

# Dev agent API endpoint
# Type: Optional
# DEV_AGENT_ENDPOINT=

# Slack webhook URL for notifications
# Type: Optional
# SLACK_WEBHOOK_URL=

# Telegram bot token for HITL approvals
# Type: Optional
# TELEGRAM_BOT_TOKEN=

# Telegram admin chat ID for notifications
# Type: Optional
# TELEGRAM_ADMIN_CHAT_ID=

# MCP (Model Context Protocol) server endpoint
# Type: Optional
# MCP_SERVER_URL=

# Agent identifier for MCP operations
# Type: Optional
# AGENT_ID=

# Mailtrap API token for email testing
# Type: Optional
# Alias: Mailtrap_API_TOKEN
# MAILTRAP_API_TOKEN=

# Redis Queue name for task processing
# Type: str
# Default: orchestrator
# RQ_QUEUE_NAME=orchestrator

# RQ serializer type
# Type: Literal
# Default: json
# RQ_SERIALIZER=json

# Flask environment mode
# Type: Literal
# Default: development
# FLASK_ENV=development

# Deployment environment
# Type: Literal
# Default: production
# ENVIRONMENT=production

# Application server port
# Type: int
# Default: 5000
# PORT=5000

# CORS allowed origins (comma-separated)
# Type: str
# Default: http://localhost:5173,http://localhost:5174
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Application version for tracking
# Type: str
# Default: 8.0.0
# APP_VERSION=8.0.0

# Current application phase
# Type: str
# Default: Phase 8
# APP_PHASE=Phase 8

# System hostname (auto-detected)
# Type: Optional
# HOSTNAME=

# Path to orchestrator module
# Type: str
# Default: handoff/20250928/40_App/orchestrator
# ORCHESTRATOR_PATH=handoff/20250928/40_App/orchestrator

# JWT secret for orchestrator API authentication
# Type: Optional
# ORCHESTRATOR_JWT_SECRET=

# CORS allowed origins for orchestrator API
# Type: str
# Default: http://localhost:5173
# ORCHESTRATOR_CORS_ORIGINS=http://localhost:5173

# Graceful shutdown timeout in seconds
# Type: int
# Default: 30
# ORCHESTRATOR_SHUTDOWN_TIMEOUT=30

# Enable orchestrator test mode
# Type: bool
# Default: False
# ORCHESTRATOR_TEST_MODE=False

# Path to governance policy files
# Type: str
# Default: policies
# POLICIES_PATH=policies

# FAQ cache TTL in seconds
# Type: int
# Default: 3600
# FAQ_CACHE_TTL=3600

# Application logging level
# Type: Literal
# Default: INFO
# LOG_LEVEL=INFO

# Enable debug mode (verbose logging)
# Type: bool
# Default: False
# DEBUG=False

# Maximum requests per window
# Type: int
# Default: 100
# RATE_LIMIT_REQUESTS=100

# Rate limit window in seconds
# Type: int
# Default: 60
# RATE_LIMIT_WINDOW=60

# Apply rate limits per user (vs global)
# Type: bool
# Default: True
# RATE_LIMIT_BY_USER=True

# Fail fast on rate limit errors
# Type: bool
# Default: False
# RATE_LIMIT_FAIL_FAST=False

# Maximum Redis connection retries for rate limiting
# Type: int
# Default: 3
# RATE_LIMIT_REDIS_MAX_RETRIES=3

# Delay between Redis retries in seconds
# Type: int
# Default: 1
# RATE_LIMIT_REDIS_RETRY_DELAY=1

# Enable Phase 7 components
# Type: bool
# Default: True
# PHASE7_ENABLED=True

# Enable Ops Agent functionality
# Type: bool
# Default: True
# OPS_AGENT_ENABLED=True

# Enable Growth Strategist agent
# Type: bool
# Default: True
# GROWTH_STRATEGIST_ENABLED=True

# Enable PM Agent functionality
# Type: bool
# Default: True
# PM_AGENT_ENABLED=True

# Enable HITL (Human-in-the-Loop) approval system
# Type: bool
# Default: True
# HITL_APPROVAL_ENABLED=True

# Enable demo mode (limited functionality)
# Type: bool
# Default: False
# DEMO_MODE=False

# Enable Docker sandbox containers for agents
# Type: bool
# Default: False
# SANDBOX_ENABLED=False

# Enable Two-Factor Authentication (2FA/TOTP) feature
# Type: bool
# Default: True
# FEATURE_2FA_ENABLED=True

# Enable Pre-Auth Token for 2FA (Week 1 - reduces password transmission)
# Type: bool
# Default: False
# FEATURE_2FA_PREAUTH=False

# Pre-Auth Token TTL in seconds (5 minutes default)
# Type: int
# Default: 300
# PREAUTH_TOKEN_TTL=300

# Enable mock users for development/testing
# Type: bool
# Default: False
# ENABLE_MOCK_USERS=False

# Enable LangGraph orchestrator mode
# Type: bool
# Default: False
# USE_LANGGRAPH=False

# Percentage of tasks to use LangGraph mode (0-100)
# Type: int
# Default: 0
# USE_LANGGRAPH_PERCENT=0

# Allow mock governance for testing
# Type: bool
# Default: False
# ALLOW_GOVERNANCE_MOCK=False

# Frontend API base URL
# Type: str
# Default: http://localhost:5001
# VITE_API_BASE_URL=http://localhost:5001

# Enabled frontend features (comma-separated)
# Type: str
# Default: dashboard,checkout,settings
# VITE_FEATURES=dashboard,checkout,settings

# Frontend Sentry DSN for error tracking
# Type: Optional
# VITE_SENTRY_DSN=

# Use mock API in frontend for development
# Type: bool
# Default: False
# VITE_USE_MOCK=False

# Stripe secret key (planned for Phase 10)
# Type: Optional
# STRIPE_SECRET_KEY=

# Stripe webhook secret key
# Type: Optional
# Alias: STRIPE_WEBHOOK_SECRET
# STRIPE_WEBHOOK_SECRET_KEY=

# DEPRECATED: Use stripe_webhook_secret_key instead
# Type: Optional
# STRIPE_WEBHOOK_SECRET=

# JWT token for E2E tests
# Type: Optional
# TEST_ADMIN_JWT=

# Enable testing mode
# Type: bool
# Default: False
# TESTING=False

# Staging environment API URL
# Type: Optional
# STAGING_API_URL=

# Test user email for staging environment
# Type: Optional
# STAGING_TEST_EMAIL=

# Test user password for staging environment
# Type: Optional
# STAGING_TEST_PASSWORD=

# Number of Gunicorn worker processes
# Type: int
# Default: 4
# GUNICORN_WORKERS=4

# Gunicorn logging level
# Type: Literal
# Default: info
# GUNICORN_LOG_LEVEL=info

# Enable Gunicorn auto-reload on code changes
# Type: bool
# Default: False
# GUNICORN_RELOAD=False

# Ops agent dashboard port
# Type: int
# Default: 8050
# DASHBOARD_PORT=8050

# Ops agent dashboard API key
# Type: Optional
# DASHBOARD_API_KEY=

# Allowed origins for ops agent dashboard
# Type: str
# Default: http://localhost:8050
# ALLOWED_ORIGINS=http://localhost:8050

# Agent workspace directory path
# Type: Optional
# WORKSPACE_PATH=

# Setuptools extension suffix (auto-detected)
# Type: Optional
# SETUPTOOLS_EXT_SUFFIX=
