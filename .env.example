FLY_API_TOKEN=your-secret-here

# System hostname (auto-detected)
# Required: False
HOSTNAME=

# Number of Gunicorn worker processes
# Required: False
GUNICORN_WORKERS=4

# Gunicorn logging level
# Required: False
GUNICORN_LOG_LEVEL=info

# Enable Gunicorn auto-reload on code changes (development only)
# Required: False
GUNICORN_RELOAD=false

# Graceful shutdown timeout in seconds
# Required: False
ORCHESTRATOR_SHUTDOWN_TIMEOUT=30

# Use PostgreSQL-based checkpointer for LangGraph state persistence. Recommended over Redis for Upstash (which doesn't support RediSearch). Requires DATABASE_URL.
# PR #2771: PostgreSQL checkpointer is the recommended option for LangGraph state persistence when using Upstash Redis, which does not support RediSearch (required by langgraph-checkpoint-redis). When enabled, LangGraph workflow state is persisted to PostgreSQL using the existing Supabase database. Checkpointer priority: PostgreSQL → Redis → MemorySaver. Uses langgraph-checkpoint-postgres package (>=2.0.0). Requires DATABASE_URL to be configured.
# Required: False
USE_POSTGRES_CHECKPOINTER=false

# Use Redis-based checkpointer for LangGraph state persistence instead of in-memory MemorySaver. Enables cross-process state recovery.
# When enabled, LangGraph workflow state is persisted to Redis instead of in-memory storage. This allows state recovery after process restarts and enables distributed workflows. Requires REDIS_URL to be configured. Uses langgraph-checkpoint-redis package. Note: Upstash Redis does not support RediSearch, so USE_POSTGRES_CHECKPOINTER is recommended instead.
# Required: False
USE_REDIS_CHECKPOINTER=false

# TTL in seconds for Redis checkpointer entries (default 24 hours). Set to 0 for no expiration.
# Controls how long LangGraph checkpoint data is retained in Redis. Default is 86400 seconds (24 hours). Set to 0 to disable expiration (not recommended for production). Lower values reduce Redis memory usage but may cause issues with long-running workflows.
# Required: False
REDIS_CHECKPOINTER_TTL=86400

# Backend for review follow-up task storage. Use 'in_memory' (default) for single-worker or 'redis' for multi-worker consistency and restart durability.
# Issue #2259: Controls where ReviewFollowUpService stores task state. in_memory is suitable for development and single-worker deployments. redis provides persistence across restarts and consistency across multiple workers.
# Required: False
REVIEW_FOLLOW_UP_STORE_BACKEND=in_memory

# TTL in seconds for review follow-up tasks in Redis (default 2592000 = 30 days). Only applies when using Redis backend.
# Issue #2259: Controls how long review follow-up tasks are retained in Redis. Default is 30 days (2592000 seconds). Tasks older than this TTL are automatically expired by Redis.
# Required: False
REVIEW_FOLLOW_UP_TASK_TTL=2592000

# Max jobs before worker restart for memory management (0 = unlimited). Recommended 10-20 for LangGraph workloads.
# Worker will exit after processing this many jobs, allowing container orchestrator to restart. This helps prevent memory accumulation from LangGraph MemorySaver checkpoints. Set to 0 or leave unset to disable (process unlimited jobs). Recommended: 10-20 for LangGraph workloads to prevent OOM.
# Required: False
RQ_MAX_JOBS=0

# Worker heartbeat interval in seconds. Optimized to reduce Redis command volume.
# Controls how often the worker sends heartbeat updates to Redis. Default is 60 seconds (reduced from 30s to cut Redis commands by 50%). Lower values provide faster detection of dead workers but increase Redis load.
# Required: False
WORKER_HEARTBEAT_INTERVAL=60

# Worker heartbeat key TTL in seconds. Should be at least 3x the interval for safety margin.
# Controls how long a worker heartbeat key remains in Redis before expiring. Default is 180 seconds (3x the interval). If a worker fails to update its heartbeat within this time, it will be considered dead. Must be greater than WORKER_HEARTBEAT_INTERVAL.
# Required: False
WORKER_HEARTBEAT_TTL=180

