{
  "ci": {
    "collect": {
      "url": [
        "/",
        "/login",
        "/pricing",
        "/dashboard",
        "/settings"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "formFactor": "desktop",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      },
      "puppeteerScript": "lhci-puppeteer-auth.cjs"
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lhci"
    }
  }
}
