# API Configuration
# For Vercel preview deployments, use '/api' (Vercel proxy handles routing)
# For local development or production, use the full backend URL with /api suffix
VITE_API_BASE_URL=/api
# Example for staging: VITE_API_BASE_URL=https://morningai-backend-v2-stg.onrender.com/api
# Example for production: VITE_API_BASE_URL=https://morningai-backend-v2.onrender.com/api

# Mock Mode (for development without backend)
VITE_USE_MOCK=false

# Sentry (optional)
VITE_SENTRY_DSN=
