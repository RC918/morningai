# Generated from config/env.schema.yaml
# DO NOT EDIT THIS FILE MANUALLY - Run scripts/generate-env-examples.py instead

# Frontend

# Frontend API base URL
# Required: False
VITE_API_BASE_URL=http://localhost:5001

# Enabled frontend features (comma-separated)
# Required: False
VITE_FEATURES=dashboard,checkout,settings

# Frontend Sentry DSN for error tracking
# Required: False
VITE_SENTRY_DSN=https://example.com

# Use mock API in frontend for development
# Required: False
VITE_USE_MOCK=false

# Application

# Flask environment mode
# Required: False
FLASK_ENV=development

# Deployment environment (development/staging/production)
# Required: False
ENVIRONMENT=production

# Application server port
# Required: False
PORT=5000

# CORS allowed origins (comma-separated)
# Required: False
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Application version for tracking
# Aligned with APP_PHASE (Phase 8 = 8.0.0)
# Required: False
APP_VERSION=8.0.0

# Current application phase
# Required: False
APP_PHASE=Phase 8

# Feature Flags

# Enable Phase 7 components
# Required: False
PHASE7_ENABLED=True

# Enable Ops Agent functionality
# Required: False
OPS_AGENT_ENABLED=True

# Enable Growth Strategist agent
# Required: False
GROWTH_STRATEGIST_ENABLED=True

# Enable PM Agent functionality
# Required: False
PM_AGENT_ENABLED=True

# Enable HITL (Human-in-the-Loop) approval system
# Required: False
HITL_APPROVAL_ENABLED=True

# Enable demo mode (limited functionality)
# Required: False
DEMO_MODE=false

# Enable Docker sandbox containers for agents
# Required: False
SANDBOX_ENABLED=false

# Enable Two-Factor Authentication (2FA/TOTP) feature
# Required: False
FEATURE_2FA_ENABLED=True

# Enable Pre-Auth Token for 2FA (Week 1 - reduces password transmission)
# When enabled, password is only transmitted once during login.
# 2FA verification uses a short-lived pre-auth token instead of password.
# Reduces password exposure risk by 50%.
# Required: False
FEATURE_2FA_PREAUTH=false

# Pre-Auth Token TTL in seconds (5 minutes default)
# Time-to-live for pre-auth tokens in seconds.
# Tokens automatically expire after this duration.
# Recommended: 300 seconds (5 minutes).
# Protected by @rate_limit decorator on verify endpoint.
# Required: False
PREAUTH_TOKEN_TTL=300
