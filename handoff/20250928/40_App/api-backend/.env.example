# Generated from config/env.schema.yaml
# DO NOT EDIT THIS FILE MANUALLY - Run scripts/generate-env-examples.py instead

# Authentication

# JWT token signing key for authentication
# Required: True
JWT_SECRET_KEY=your-secret-here

# Admin user password for system access
# Required: True
ADMIN_PASSWORD=your-secret-here

# Security

# Flask application secret key for sessions (preferred over SECRET_KEY)
# Preferred secret key name. Use this instead of SECRET_KEY.
# SECRET_KEY is deprecated and will be removed after 30-day grace period.
# Required: False
FLASK_SECRET_KEY=your-secret-here

# Application secret key for Flask sessions (DEPRECATED - use FLASK_SECRET_KEY)
# DEPRECATED: Use FLASK_SECRET_KEY instead.
# This key is maintained for backward compatibility during 30-day migration period.
# Support ends: 2025-11-30
# Required: True
SECRET_KEY=your-secret-here

# Master encryption key for sensitive data (preferred over MASTER_KEY)
# Preferred master key name. Use this instead of MASTER_KEY.
# MASTER_KEY is deprecated and will be removed after 30-day grace period.
# Required: False
ENCRYPTION_MASTER_KEY=your-secret-here

# Master encryption key for sensitive data (DEPRECATED - use ENCRYPTION_MASTER_KEY)
# DEPRECATED: Use ENCRYPTION_MASTER_KEY instead.
# This key is maintained for backward compatibility during 30-day migration period.
# Support ends: 2025-11-30
# Required: False
MASTER_KEY=your-secret-here

# Database

# PostgreSQL database connection URL
# Required: True
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis connection URL for queue and caching. Use rediss:// (double 's') for TLS-encrypted connections. For production, use UPSTASH_REDIS_REST_URL (HTTPS/TLS by default)
# - Non-TLS: redis://localhost:6379/0
# - TLS: rediss://user:pass@host:6380/0
# - Recommendation: Use UPSTASH_REDIS_REST_URL for production (HTTPS/TLS by default)
# Required: False
REDIS_URL=redis://localhost:6379/0

# Supabase memory table name for vector storage
# Required: False
MEMORY_TABLE=memory

# Cloud Services

# Supabase project URL
# Required: True
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase anonymous/public key
# Required: True
SUPABASE_ANON_KEY=your-secret-here

# Supabase service role key (admin access)
# Required: True
SUPABASE_SERVICE_ROLE_KEY=your-secret-here

# Cloudflare API token for DNS/CDN management
# Required: True
CLOUDFLARE_API_TOKEN=your-secret-here

# Cloudflare zone ID for domain
# Required: True
CLOUDFLARE_ZONE_ID=

# Vercel deployment token
# Required: True
VERCEL_TOKEN=your-secret-here

# Vercel organization ID
# Required: True
VERCEL_ORG_ID=

# Vercel project ID
# Required: True
VERCEL_PROJECT_ID=

# Render API key for deployments
# Required: True
RENDER_API_KEY=your-secret-here

# Upstash Redis REST API URL (HTTPS/TLS enabled by default)
# Recommended for production - HTTPS/TLS enabled by default
# Required: True
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io

# Upstash Redis REST API token (HTTPS/TLS enabled by default)
# Required when using UPSTASH_REDIS_REST_URL
# Required: True
UPSTASH_REDIS_REST_TOKEN=your-secret-here

# Infrastructure

# Render instance ID (auto-set by Render platform)
# Required: False
RENDER_INSTANCE_ID=

# Fly.io API token for sandbox deployments
# Required: False
FLY_API_TOKEN=your-secret-here

# System hostname (auto-detected)
# Required: False
HOSTNAME=

# Monitoring

# Sentry DSN for error tracking
# Required: True
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Sentry authentication token for API access
# Required: False
SENTRY_AUTH_TOKEN=your-secret-here

# Integration

# GitHub API token for repository operations (permissions repo, workflow)
# Required: True
GITHUB_TOKEN=your-secret-here

# GitHub repository in owner/repo format
# Required: True
GITHUB_REPO=RC918/morningai

# OpenAI API key for embeddings and LLM operations
# Required: True
OPENAI_API_KEY=your-secret-here

# Slack webhook URL for notifications
# Required: False
SLACK_WEBHOOK_URL=https://example.com

# Telegram bot token for HITL approvals
# Required: False
TELEGRAM_BOT_TOKEN=your-secret-here

# Telegram admin chat ID for notifications
# Required: False
TELEGRAM_ADMIN_CHAT_ID=

# MCP (Model Context Protocol) server endpoint
# Required: False
MCP_SERVER_URL=https://example.com

# Agent identifier for MCP operations
# Required: False
AGENT_ID=

# Worker

# Redis Queue name for task processing
# Required: False
RQ_QUEUE_NAME=orchestrator

# RQ serializer type (json/pickle)
# Required: False
RQ_SERIALIZER=json

# Application

# Flask environment mode
# Required: False
FLASK_ENV=development

# Deployment environment (development/staging/production)
# Required: False
ENVIRONMENT=production

# Application server port
# Required: False
PORT=5000

# CORS allowed origins (comma-separated)
# Required: False
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Application version for tracking
# Aligned with APP_PHASE (Phase 8 = 8.0.0)
# Required: False
APP_VERSION=8.0.0

# Current application phase
# Required: False
APP_PHASE=Phase 8

# Feature Flags

# Enable Phase 7 components
# Required: False
PHASE7_ENABLED=True

# Enable Ops Agent functionality
# Required: False
OPS_AGENT_ENABLED=True

# Enable Growth Strategist agent
# Required: False
GROWTH_STRATEGIST_ENABLED=True

# Enable PM Agent functionality
# Required: False
PM_AGENT_ENABLED=True

# Enable HITL (Human-in-the-Loop) approval system
# Required: False
HITL_APPROVAL_ENABLED=True

# Enable demo mode (limited functionality)
# Required: False
DEMO_MODE=false

# Enable Docker sandbox containers for agents
# Required: False
SANDBOX_ENABLED=false

# Enable Two-Factor Authentication (2FA/TOTP) feature
# Required: False
FEATURE_2FA_ENABLED=true

# Testing

# JWT token for E2E tests
# Required: False
TEST_ADMIN_JWT=your-secret-here
