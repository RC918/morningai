# Generated from config/env.schema.yaml
# DO NOT EDIT THIS FILE MANUALLY - Run scripts/generate-env-examples.py instead

# Authentication

# JWT token signing key for authentication
# Required: True
JWT_SECRET_KEY=your-secret-here

# JWT access token expiry time in minutes (CI/E2E can override to 60)
# Controls how long JWT access tokens remain valid before requiring refresh.
# - Production: 15 minutes (default, security best practice)
# - CI/E2E: 60 minutes (allows long-running test suites)
# - Development: 15 minutes (matches production behavior)
# Longer expiry times reduce security but improve user experience and test reliability.
# Required: False
ACCESS_TOKEN_EXPIRY_MINUTES=15

# Admin user password for system access
# Required: True
ADMIN_PASSWORD=your-secret-here

# Owner account password (deprecated - use ADMIN_PASSWORD)
# DEPRECATED: Use ADMIN_PASSWORD instead.
# Maintained for backward compatibility.
# Required: False
OWNER_PASSWORD=your-secret-here

# Security

# Flask application secret key for sessions
# Required in production. App will fail to start without this key.
# Deprecated SECRET_KEY was removed on 2025-11-30.
# Required: True
FLASK_SECRET_KEY=your-secret-here

# Master encryption key for sensitive data
# Required in production. App will fail to start without this key.
# Deprecated MASTER_KEY was removed on 2025-11-30.
# Required: True
ENCRYPTION_MASTER_KEY=your-secret-here

# Enable Secure flag on authentication cookies (HTTPS-only)
# When true, cookies are only sent over HTTPS connections.
# Defaults to true in production, false in development.
# Required to be true when COOKIE_SAMESITE=None (browser requirement).
# Required: False
COOKIE_SECURE=True

# SameSite attribute for authentication cookies
# Controls when cookies are sent on cross-site requests.
# - Strict: Cookies only sent on same-site requests (most secure)
# - Lax: Cookies sent on top-level navigation (default, balanced)
# - None: Cookies sent on all requests (requires COOKIE_SECURE=true)
# For cross-domain deployments (e.g., Staging), use None with COOKIE_SECURE=true.
# Required: False
COOKIE_SAMESITE=Lax

# Fernet encryption key for TOTP secrets (Base64-encoded, AES-128-CBC + HMAC-SHA256)
# Required for 2FA/TOTP functionality. Generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Required: True
TOTP_ENCRYPTION_KEY=your-secret-here

# Comma-separated list of allowed actions for agents (empty = use default whitelist)
# Phase 1 Security Foundation: Action whitelist for semantic task rules.
# Empty string = use DEFAULT_ALLOWED_ACTIONS (read_file, write_file, create_file, list_directory, search_code, run_tests, run_lint, create_pr, add_comment, update_documentation).
# When set, only the specified actions are allowed.
# Example: "read_file,write_file,run_tests,create_pr"
# Required: False
PROJECT_ENGINEER_ALLOWED_ACTIONS=

# Comma-separated list of file patterns to block from agent modification (empty = use default sensitive patterns)
# Phase 1 Security Foundation: Sensitive file blocking for semantic task rules.
# Empty string = use SENSITIVE_FILE_PATTERNS (.env, credentials.json, secrets.yaml, private_key, etc.).
# When set, only the specified patterns are blocked.
# Supports wildcard patterns like "*.config" and exact matches like ".env".
# Example: ".env,.env.local,credentials.json,secrets.yaml"
# Required: False
PROJECT_ENGINEER_BLOCKED_FILES=

# Require Human-in-the-Loop approval for high-risk operations (DROP TABLE, DELETE, rm -rf, etc.)
# Phase 1 Security Foundation: HITL requirement for high-risk operations.
# When true (default), high-risk operations like DROP TABLE, DELETE FROM, rm -rf, etc. require manual approval.
# When false, high-risk operations are logged but allowed (NOT RECOMMENDED for production).
# High-risk patterns: DROP TABLE, DROP DATABASE, DELETE FROM, TRUNCATE, ALTER TABLE, rm -rf, rm -r, sudo rm, chmod 777, chown
# Required: False
PROJECT_ENGINEER_REQUIRE_HITL_HIGH_RISK=True

# JWT secret for orchestrator API authentication
# Required: False
ORCHESTRATOR_JWT_SECRET=your-secret-here

# Ops agent dashboard API key
# Required: False
DASHBOARD_API_KEY=your-secret-here

# Domain for authentication cookies (e.g., .example.com for subdomain sharing)
# Required: False
COOKIE_DOMAIN=

# Path scope for authentication cookies
# Required: False
COOKIE_PATH=/

