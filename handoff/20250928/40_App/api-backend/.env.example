# Generated from config/env.schema.yaml
# DO NOT EDIT THIS FILE MANUALLY - Run scripts/generate-env-examples.py instead

# Authentication

# JWT token signing key for authentication
# Required: True
JWT_SECRET_KEY=your-secret-here

# Admin user password for system access
# Required: True
ADMIN_PASSWORD=your-secret-here

# Security

# Flask application secret key for sessions (preferred over SECRET_KEY)
# Preferred secret key name. Use this instead of SECRET_KEY.
# SECRET_KEY is deprecated and will be removed after 30-day grace period.
# Required: False
FLASK_SECRET_KEY=your-secret-here

# Application secret key for Flask sessions (DEPRECATED - use FLASK_SECRET_KEY)
# DEPRECATED: Use FLASK_SECRET_KEY instead.
# This key is maintained for backward compatibility during 30-day migration period.
# Support ends: 2025-11-30
# Required: True
SECRET_KEY=your-secret-here

# Master encryption key for sensitive data (preferred over MASTER_KEY)
# Preferred master key name. Use this instead of MASTER_KEY.
# MASTER_KEY is deprecated and will be removed after 30-day grace period.
# Required: False
ENCRYPTION_MASTER_KEY=your-secret-here

# Master encryption key for sensitive data (DEPRECATED - use ENCRYPTION_MASTER_KEY)
# DEPRECATED: Use ENCRYPTION_MASTER_KEY instead.
# This key is maintained for backward compatibility during 30-day migration period.
# Support ends: 2025-11-30
# Required: False
MASTER_KEY=your-secret-here

# Enable Secure flag on authentication cookies (HTTPS-only)
# When true, cookies are only sent over HTTPS connections.
# Defaults to true in production, false in development.
# Required to be true when COOKIE_SAMESITE=None (browser requirement).
# Required: False
COOKIE_SECURE=True

# SameSite attribute for authentication cookies
# Controls when cookies are sent on cross-site requests.
# - Strict: Cookies only sent on same-site requests (most secure)
# - Lax: Cookies sent on top-level navigation (default, balanced)
# - None: Cookies sent on all requests (requires COOKIE_SECURE=true)
# For cross-domain deployments (e.g., Staging), use None with COOKIE_SECURE=true.
# Required: False
COOKIE_SAMESITE=Lax

# Fernet encryption key for TOTP secrets (Base64-encoded, AES-128-CBC + HMAC-SHA256)
# Required for 2FA/TOTP functionality. Generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Required: True
TOTP_ENCRYPTION_KEY=your-secret-here

# JWT secret for orchestrator API authentication
# Required: False
ORCHESTRATOR_JWT_SECRET=your-secret-here

# Ops agent dashboard API key
# Required: False
DASHBOARD_API_KEY=your-secret-here

# Database

# PostgreSQL database connection URL
# Required: True
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis connection URL for queue and caching. Use rediss:// (double 's') for TLS-encrypted connections. For production, use UPSTASH_REDIS_REST_URL (HTTPS/TLS by default)
# - Non-TLS: redis://localhost:6379/0
# - TLS: rediss://user:pass@host:6380/0
# - Recommendation: Use UPSTASH_REDIS_REST_URL for production (HTTPS/TLS by default)
# Required: False
REDIS_URL=redis://localhost:6379/0

# Supabase memory table name for vector storage
# Required: False
MEMORY_TABLE=memory

# Supabase PostgreSQL database password (for direct psql connections)
# Used by migration scripts for direct database access
# Required: False
SUPABASE_DB_PASSWORD=your-secret-here

# Redis key prefix for namespacing
# Required: False
REDIS_KEY_PREFIX=morningai

# Maximum database connection pool size
# Required: False
DB_POOL_MAX=10

# Cloud Services

