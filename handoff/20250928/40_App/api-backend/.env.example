# Use Redis-based checkpointer for LangGraph state persistence instead of in-memory MemorySaver. Enables cross-process state recovery.
# When enabled, LangGraph workflow state is persisted to Redis instead of in-memory storage. This allows state recovery after process restarts and enables distributed workflows. Requires REDIS_URL to be configured. Uses langgraph-checkpoint-redis package.
# Required: False
USE_REDIS_CHECKPOINTER=false

# TTL in seconds for Redis checkpointer entries (default 24 hours). Set to 0 for no expiration.
# Controls how long LangGraph checkpoint data is retained in Redis. Default is 86400 seconds (24 hours). Set to 0 to disable expiration (not recommended for production). Lower values reduce Redis memory usage but may cause issues with long-running workflows.
# Required: False
REDIS_CHECKPOINTER_TTL=86400

# Max jobs before worker restart for memory management (0 = unlimited). Recommended 10-20 for LangGraph workloads.
# Worker will exit after processing this many jobs, allowing container orchestrator to restart. This helps prevent memory accumulation from LangGraph MemorySaver checkpoints. Set to 0 or leave unset to disable (process unlimited jobs). Recommended: 10-20 for LangGraph workloads to prevent OOM.
# Required: False
RQ_MAX_JOBS=0

