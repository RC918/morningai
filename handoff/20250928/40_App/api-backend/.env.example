# Use VERCEL_TOKEN as the primary token for all Vercel operations.
# VERCEL_TOKEN_NEW is only needed during token rotation:
# 1. Generate new token in Vercel Dashboard
# 2. Set as VERCEL_TOKEN_NEW
# 3. Verify all operations work
# 4. Move value to VERCEL_TOKEN
# 5. Delete VERCEL_TOKEN_NEW
# Required: False
VERCEL_TOKEN_NEW=your-secret-here

