PM_AGENT_ENABLED=True

# Enable Refactor Agent for automated TS strict mode fixes
# Required: False
REFACTOR_AGENT_ENABLED=True

# Number of TS errors to fix per nightly run
# Required: False
REFACTOR_AGENT_ERRORS_PER_RUN=10

# Automatically create PRs for refactor fixes (disabled by default, enable after staging validation)
# Required: False
REFACTOR_AGENT_AUTO_PR=false

# Enable HITL (Human-in-the-Loop) approval system
# Required: False
HITL_APPROVAL_ENABLED=True

# Enable demo mode (limited functionality)
# Required: False
DEMO_MODE=false

# Enable Docker sandbox containers for agents
# Required: False
SANDBOX_ENABLED=false

# Enable Two-Factor Authentication (2FA/TOTP) feature
# Required: False
FEATURE_2FA_ENABLED=True

# Enable Pre-Auth Token for 2FA (Week 1 - reduces password transmission)
# When enabled, password is only transmitted once during login.
# 2FA verification uses a short-lived pre-auth token instead of password.
# Reduces password exposure risk by 50%.
# Required: False
FEATURE_2FA_PREAUTH=false

# Pre-Auth Token TTL in seconds (5 minutes default)
# Time-to-live for pre-auth tokens in seconds.
# Tokens automatically expire after this duration.
# Recommended: 300 seconds (5 minutes).
# Protected by @rate_limit decorator on verify endpoint.
# Required: False
PREAUTH_TOKEN_TTL=300

# Enable mock users for development/testing (MUST be false in production)
# WARNING: Must be false in production and staging environments.
# When true, allows authentication with hardcoded mock users (owner@morningai.com, admin@morningai.com).
# Production validation will fail if this is enabled.
# Required: False
ENABLE_MOCK_USERS=false

# Enable orchestrator/agent routes (set to false in CI/E2E to bypass Redis/TLS dependencies)
# Controls whether orchestrator/agent routes are loaded and registered.
# - true (default): Agent routes enabled for production use
# - false: Agent routes disabled (used in CI/E2E tests to avoid Redis TLS requirements)
# When disabled, only core authentication and application routes are available.
# Required: False
ENABLE_ORCHESTRATOR=True

# Enable LangGraph orchestrator mode (default: simple mode)
# Controls orchestrator execution mode:
# - false (default): Simple mode for faster response
# - true: LangGraph mode with full stateful workflow and retry logic
# Required: False
USE_LANGGRAPH=false

# Percentage of tasks to use LangGraph mode (0-100, for canary rollout)
# Canary rollout mechanism for LangGraph. Takes precedence over USE_LANGGRAPH.
# Example: 15 = 15% of tasks use LangGraph, 85% use simple mode.
# Recommended rollout phases (see ADR-005):
# - Phase 1: 5% (baseline metrics)
# - Phase 2: 15% (staging validation)
# - Phase 3: 25% (expanded canary)
# - Phase 4: 50% (majority traffic)
# - Phase 5: 100% (full rollout)
# Required: False
USE_LANGGRAPH_PERCENT=0

# Enable LangGraph mode for FAQ tasks (default false to preserve low latency)
# FAQ tasks bypass LangGraph by default due to latency requirements.
# Set to true to experiment with LangGraph for FAQ generation.
# Only effective when USE_LANGGRAPH=true or USE_LANGGRAPH_PERCENT>0.
# Required: False
USE_LANGGRAPH_FOR_FAQ=false

# Enable LLM-powered planner in LangGraph orchestrator (Phase 1)
# Controls whether the planner node uses LLM for dynamic planning:
# - false (default): Static planning (hardcoded steps)
# - true: LLM-powered dynamic planning (GPT-4 generates execution steps)
# Requires OPENAI_API_KEY to be set for LLM operations.
# Only effective when USE_LANGGRAPH=true or USE_LANGGRAPH_PERCENT>0.
# Required: False
USE_LLM_PLANNER=false

# Enable AI-powered code generation workflow (Phase 2)
# Controls whether the code generation workflow is enabled:
# - false (default): Code generation workflow disabled
# - true: Enable LLM-powered code generation with security validation
# Requires OPENAI_API_KEY to be set for LLM operations.
# Required: False
USE_CODE_GENERATION=false

# Percentage of tasks to use code generation workflow (0-100, for canary rollout)
# Canary rollout mechanism for code generation workflow. Takes precedence over USE_CODE_GENERATION.
# Example: 10 = 10% of tasks use code generation, 90% use standard workflow.
# Uses same MD5 hash routing as USE_LANGGRAPH_PERCENT for deterministic task assignment.
# Required: False
USE_CODEGEN_WORKFLOW_PERCENT=0

# Enable ProjectEngineerAgent code generation execution mode (Phase 2 Step C)
# Controls whether ProjectEngineerAgent can execute code generation:
# - false (default): Analysis-only mode, tasks are classified but not executed
# - true: Execution mode, safe tasks trigger CodeGenerationWorkflow
# Requires dev_agent to be provided to ProjectEngineerAgent constructor.
# Only affects safe tasks (documentation_update, test_generation).
# Unsafe tasks are always skipped regardless of this setting.
# Required: False
ENABLE_PROJECT_ENGINEER_CODEGEN=false

# Enable ProjectEngineerAgent auto-fix mode in fixer_node (Phase 2 Step C Fixer Node)
# Controls whether fixer_node can use ProjectEngineerAgent for auto-fix:
# - false (default): Fixer node only increments retry count, no auto-fix
# - true: Fixer node uses ReviewerAgent + ProjectEngineerAgent to auto-fix CI failures
# Dependencies: Requires ENABLE_PROJECT_ENGINEER_CODEGEN=true to actually execute fixes.
# Recommended rollout:
# - Staging: true (with PROJECT_ENGINEER_FIXER_PERCENT=5-10)
# - Production: false initially, then true after staging validation
# Use PROJECT_ENGINEER_FIXER_PERCENT for canary rollout.
# Required: False
ENABLE_PROJECT_ENGINEER_FIXER=false

# Enable querying past failures for learning context in Planner (Phase 2 Observer Node)
# Controls whether the Planner queries past failures for learning context:
# - true (default): Planner includes past failure context in prompts
# - false: Planner skips failure learning context (useful for debugging or reducing latency)
# When enabled, the Observer Node queries similar past failures and includes relevant error-fix pairs in the Planner prompt to help avoid repeating mistakes.
# Required: False
ENABLE_FAILURE_LEARNING_CONTEXT=True

# Enable Meta Agent autonomous execution path via webhooks (#1822 Integrated Development Tools)
# Controls Meta Agent integration for end-to-end autonomous execution:
# - false (default): Webhooks use standard orchestrator task flow
# - true: Webhooks can route tasks to Meta Agent via run_meta_agent_task
# When enabled, webhook handlers can use the meta_agent task type to route tasks through AutonomousExecutor for full autonomous execution including VM provisioning, VS Code IDE integration, and confidence scoring.
# Dependencies: None (VM provisioning requires ENABLE_META_AGENT_VM=true)
# Recommended rollout:
# - Staging: true (for testing end-to-end flow)
# - Production: false initially, then true after staging validation
# Required: False
ENABLE_META_AGENT=false

# Enable VM provisioning for Meta Agent isolated execution (requires ENABLE_META_AGENT=true)
# Controls VM provisioning for Meta Agent:
# - false (default): Meta Agent runs in local mode without VM isolation
# - true: Meta Agent provisions isolated VMs for task execution
# Dependencies: Requires ENABLE_META_AGENT=true to have any effect.
# VM provider is controlled by META_AGENT_VM_PROVIDER setting.
# Required: False
ENABLE_META_AGENT_VM=false

# VM provider for Meta Agent isolated execution
# Specifies the VM provider when ENABLE_META_AGENT_VM=true:
# - local (default): Run tasks locally without VM isolation
# - docker: Use Docker containers for isolation
# - fly: Use Fly.io VMs for cloud-based isolation
# Dependencies: Only effective when ENABLE_META_AGENT_VM=true.
# Required: False
META_AGENT_VM_PROVIDER=local

# Enable DeepWiki knowledge base service for code query and session insights (#1824 DeepWiki 知識庫)
# Controls DeepWiki knowledge base service:
# - false (default): DeepWiki service is disabled
# - true: DeepWiki service is enabled for code query and session insights
# When enabled, DeepWiki provides:
# - Code question answering using Knowledge Graph patterns
# - Error lookup from past failure records
# - Session insights analysis
# - Improvement suggestions based on execution history
# Dependencies: Works best with ENABLE_FAILURE_LEARNING_CONTEXT=true and ENABLE_KNOWLEDGE_GRAPH_LEARNING=true.
# Required: False
ENABLE_DEEPWIKI=false

# Maximum number of knowledge sources to include in DeepWiki query results (1-20, default 5)
# Controls the number of sources returned in DeepWiki queries.
# Higher values provide more context but increase response size and latency.
# Recommended: 3-5 for most use cases, up to 10 for detailed analysis.
# Required: False
DEEPWIKI_MAX_SOURCES=5

# Enable agent evaluation metrics collection and capability regression detection (Phase 2
# Controls agent evaluation integration:
# - true (default): Collect metrics and detect capability regression
# - false: Disable evaluation (useful for debugging or reducing overhead)
# Required: False
ENABLE_AGENT_EVAL=True

# Percentage of tasks to use auto-fix in fixer_node (0-100, for canary rollout)
# Canary rollout mechanism for auto-fix in fixer_node.
# Example: 10 = 10% of tasks use auto-fix, 90% use standard retry.
# Uses MD5 hash routing based on trace_id/pr_number for deterministic task assignment.
# Dependencies: Only effective when ENABLE_PROJECT_ENGINEER_FIXER=true.
# Recommended values:
# - Staging: 5-10 (start with 5-10% canary)
# - Production: 0 initially, then gradually increase (5 -> 10 -> 25 -> 50 -> 100)
# Max retries: Fixer node will retry up to MAX_FIXER_RETRIES (default 3) times before giving up.
# Required: False
PROJECT_ENGINEER_FIXER_PERCENT=0

# Master switch for auto-fix execution from AI reviewer comments (Issue
# Epic #2311 Phase 2: Auto-repair v1 safety mechanism.
# When enabled, AI reviewer comments can trigger automatic code fixes.
# Dependencies: Requires AUTO_FIX_CATEGORIES and rate limiting settings.
# Required: False
AUTO_FIX_ENABLED=false

# Comma-separated list of categories allowed for auto-fix
# Allowlist of comment categories that can trigger auto-fix.
# Valid values: style, documentation, bug_fix, refactor, security, performance.
# Empty string = no categories allowed (effectively disables auto-fix).
# Required: False
AUTO_FIX_CATEGORIES=style,documentation

# Comma-separated list of repos allowed for auto-fix (empty = all repos)
# Repository allowlist for auto-fix execution.
# Empty string = all repos allowed.
# Example: "RC918/morningai,RC918/other-repo"
# Required: False
AUTO_FIX_REPOS_ALLOWLIST=

# Maximum auto-fix attempts per PR (1-10, default 3)
# Loop protection: Prevents infinite auto-fix loops.
# After this many attempts, auto-fix is disabled for the PR.
# Required: False
AUTO_FIX_MAX_RETRIES=3

# Maximum auto-fix attempts per repo per hour (1-100, default 10)
# Rate limiting: Prevents excessive auto-fix activity per repository.
# Uses Redis ZSET-based sliding window rate limiting.
# Required: False
AUTO_FIX_PER_REPO_PER_HOUR=10

# Maximum auto-fix attempts per PR per hour (1-20, default 3)
# Rate limiting: Prevents excessive auto-fix activity per PR.
# Uses Redis ZSET-based sliding window rate limiting.
# Required: False
AUTO_FIX_PER_PR_PER_HOUR=3

# Maximum global auto-fix attempts per hour (1-1000, default 100)
# Rate limiting: Global cap on auto-fix activity.
# Uses Redis ZSET-based sliding window rate limiting.
# Fail-open: If Redis is unavailable, requests are allowed (with monitoring alert).
# Required: False
AUTO_FIX_GLOBAL_PER_HOUR=100

# Maximum execution time for ProjectEngineerAgent.run_task() in seconds
# Phase 3 PR-4: Agent-level timeout for ProjectEngineerAgent tasks.
# Default: 300 seconds (5 minutes)
# Range: 30-1800 seconds (30 seconds to 30 minutes)
# Required: False
PROJECT_ENGINEER_TASK_TIMEOUT_SECONDS=300

# Comma-separated list of allowed repositories for ProjectEngineerAgent
# Phase 3 PR-4: Repository whitelist for semantic task rules.
# Empty string = all repos allowed (not recommended for production).
# Example: "RC918/morningai,RC918/other-repo"
# Required: False
PROJECT_ENGINEER_ALLOWED_REPOS=RC918/morningai

# Comma-separated list of allowed directory prefixes for code generation
# Phase 4 PR-1: Directory whitelist for semantic task rules.
# Empty string = all directories allowed (not recommended for production).
# Paths are normalized and checked for traversal attacks (../).
# Example: "docs/,tests/,handoff/"
# Required: False
PROJECT_ENGINEER_ALLOWED_DIRECTORIES=docs/,tests/,handoff/

# Comma-separated list of allowed task types for code generation (empty = all safe task types)
# Phase 4 PR-1: Task type whitelist for semantic task rules.
# Empty string = all safe task types from SAFE_TASK_TYPES are allowed.
# When set, only the specified task types are allowed (must also be in SAFE_TASK_TYPES).
# Example: "documentation_update,test_generation"
# Required: False
PROJECT_ENGINEER_ALLOWED_TASK_TYPES=

# Enable canary deployment metrics collection
# Required: False
CANARY_METRICS_ENABLED=True

# Enable canary SLO alerting
# Required: False
CANARY_ALERTING_ENABLED=True

# Time window for canary SLO evaluation in minutes
# Required: False
CANARY_WINDOW_MINUTES=15

# Canary p95 latency threshold in milliseconds
# Required: False
CANARY_P95_MS_THRESHOLD=2500

# Canary 5xx error rate threshold percentage
# Required: False
CANARY_5XX_RATE_THRESHOLD=1.0

# Canary planner failure rate threshold percentage
# Required: False
CANARY_FAILURE_RATE_THRESHOLD=5.0

# Canary latency histogram buckets in milliseconds (comma-separated)
# Required: False
CANARY_BUCKETS_MS=50,100,200,400,800,1600,3200

# Optional webhook URL for operational alerts (Slack/email/custom)
# Required: False
OPS_ALERT_WEBHOOK_URL=

# Use tiktoken for accurate token estimation instead of heuristic
# Required: False
USE_TIKTOKEN_ESTIMATOR=false

# Enable Phase 3 metrics collection for ProjectEngineerAgent monitoring
# Phase 3 metrics track ProjectEngineerAgent task execution, latency, and semantic rule violations.
# Metrics are stored in Redis with minute-bucket keys and 2-hour TTL.
# Use tools/monitoring/phase3_dashboard.py to view metrics.
# Required: False
PHASE3_METRICS_ENABLED=True

# Phase 3 p95 latency threshold in milliseconds (default 5 minutes)
# Phase 3 tasks are longer than Phase 1 (code generation vs FAQ).
# Default: 300000ms (5 minutes)
# Warning threshold: 600000ms (10 minutes)
# Required: False
PHASE3_P95_MS_THRESHOLD=300000

# Phase 3 task success rate threshold percentage
# Required: False
PHASE3_SUCCESS_RATE_THRESHOLD=95.0

# Phase 3 task timeout rate threshold percentage
# Required: False
PHASE3_TIMEOUT_RATE_THRESHOLD=2.0

# Enable cookie-based authentication (vs header-only)
# Required: False
FEATURE_COOKIE_AUTH=True

# Deployment

# Repository root path for production/staging deployments
# Specifies the absolute path to the MorningAI repository root.
# Required in production/staging environments where the repository is not located at ~/repos/morningai.
# If not set, the system will attempt to discover the repository root using: 1. MORNINGAI_REPO_PATH environment variable (this variable) 2. git rev-parse --show-toplevel (if in a git repository) 3. Project root detection via marker files (.git, config, handoff, etc.)
# Example values: - /opt/render/project/src (Render.com deployment) - /app (Docker container) - /home/ubuntu/repos/morningai (development)
# IMPORTANT: This must point to the repository root directory containing the config/, handoff/, agents/, and tools/ directories.
# Required: False
MORNINGAI_REPO_PATH=/home/user/repos/morningai

# Testing

# Enable E2E test mode (NEVER enable in production - XSS security risk)
# Controls whether JWT tokens are stored in localStorage for E2E test persistence.
# - false (default): Tokens only stored in memory (production-safe, prevents XSS attacks)
# - true: Tokens also stored in localStorage (E2E tests only, required for Playwright storageState)
# SECURITY WARNING: NEVER set to true in production builds. This creates XSS vulnerability.
# Only set to true in CI/E2E test builds where Playwright needs token persistence across page navigations.
# Production builds must always use in-memory token storage only.
# Required: False
VITE_E2E=false

# JWT token for E2E tests
# Required: False
TEST_ADMIN_JWT=your-secret-here

# Enable RLS (Row Level Security) tests with real user JWTs (MUST be true to run RLS tests)
# WARNING: Must be explicitly set to true to run RLS tests.
# This prevents accidental execution of destructive RLS tests against production.
# Used in conjunction with TEST_SUPABASE_URL for environment validation.
# Required: False
RLS_TESTS_ALLOWED=false

# Whitelisted Supabase URL for RLS testing (must match SUPABASE_URL exactly)
# Required for RLS tests. Must exactly match SUPABASE_URL.
# This whitelists the allowed test environment to prevent running against production.
# RLS tests will skip if SUPABASE_URL does not match this value.
# Required: False
TEST_SUPABASE_URL=https://xxxxx.supabase.co

# Enable migration idempotency tests (static analysis of SQL migrations)
# When set to true, allows migration idempotency tests to run.
# These tests perform static analysis of SQL migration files to verify:
# - Idempotent SQL syntax (IF NOT EXISTS, CREATE OR REPLACE, etc.)
# - No duplicate migration numbers
# - Proper transaction handling
# - Rollback documentation exists
# Does NOT connect to database or execute migrations.
# Required: False
IDEMPOTENCY_TESTS_ALLOWED=false

# Enable testing mode (disables certain checks and external calls)
# Required: False
TESTING=false

# Enable Playwright browser E2E tests (requires staging credentials)
# Required: False
RUN_PY_BROWSER_E2E=false

# Enable orchestrator test mode
# Required: False
ORCHESTRATOR_TEST_MODE=false

# Skip PR creation in orchestrator, return synthetic results. Use in staging to avoid PR bombing.
# When enabled, the orchestrator will skip all GitHub operations (branch creation, commits, PR creation) and return synthetic results instead. This is useful for staging environments to test the orchestrator pipeline without creating real PRs. Set ORCHESTRATOR_DRY_RUN=true in staging to prevent PR bombing during testing.
# Required: False
ORCHESTRATOR_DRY_RUN=false

# Enable rate limiting in test environment (default false - rate limiting disabled in tests)
# When false (default), rate limiting is bypassed in tests to prevent 429 errors from interfering with validation tests.
# Set to true only in tests that specifically test rate limiting behavior.
# Required: False
ENABLE_RATE_LIMIT_IN_TESTS=false

# Allow mock governance for testing
# Required: False
ALLOW_GOVERNANCE_MOCK=false

# Override for repository root path discovery (for testing/CI environments)
# Required: False
REPO_ROOT_PATH=

# Staging environment API URL (for testing scripts)
# Required: False
STAGING_API_URL=https://example.com

# Test user email for staging environment
# Required: False
STAGING_TEST_EMAIL=

# Test user password for staging environment
# Required: False
STAGING_TEST_PASSWORD=your-secret-here

# Force enable 2FA in test environment
# Required: False
FORCE_ENABLE_2FA_IN_TESTS=false
