# Owner Console Environment Variables

# API Base URL - Backend API endpoint
VITE_API_BASE_URL=https://morningai-backend-v2.onrender.com

# Owner Console Flag - Identifies this as the owner console
VITE_OWNER_CONSOLE=true

# Optional: Sentry DSN for error tracking
# VITE_SENTRY_DSN=

# Optional: Environment name
# VITE_ENVIRONMENT=production

# Supabase Configuration (required for SSO)
# Supabase project URL and anonymous key for authentication
# VITE_SUPABASE_URL=your_supabase_project_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
